# ==============================================================================
# AutoSOC Environment Configuration
# Copy this file to `.env` and fill in your actual secrets.
# ==============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-secret-key
LOG_LEVEL=INFO

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=autosoc_knowledge

# --- Arize Phoenix (local LLM observability) ---
PHOENIX_HOST=localhost
PHOENIX_PORT=6006

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- gRPC ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_TLS_CERT_PATH=certs/server.crt
GRPC_TLS_KEY_PATH=certs/server.key
GRPC_CA_CERT_PATH=certs/ca.crt

# --- LLM Provider ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Guardrails ---
INJECTION_SCORE_THRESHOLD=0.85
NLI_FAITHFULNESS_THRESHOLD=0.95
CRAG_RELEVANCE_THRESHOLD=0.80
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
