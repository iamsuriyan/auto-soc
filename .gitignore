# ==============================================================================
# AutoSOC .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key
certs/*.crt
certs/*.key
!certs/.gitkeep

# IDE and Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing and coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# Linters & Tooling
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Docker and container data
*.pid

# Data files & local logs
*.log
logs/
data/
storage/
mnt/
